msgstr "transient scaduti"

#. translators: %s: comma-separated list such as "3 revisions, 1 auto-drafts".
#: admin/class-skit-admin.php:294
#, php-format
msgid "Database cleaned: %s."
msgstr "Database ripulito: %s."


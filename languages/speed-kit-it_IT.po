#. Plugin Name of the plugin
#: speed-kit.php
msgid "SpeedKit"
msgstr "SpeedKit"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: speed-kit.php
msgid "https://github.com/domenicosacchi/speed-kit"
msgstr "https://github.com/domenicosacchi/speed-kit"

#. Description of the plugin
#: speed-kit.php
msgid "Caching and performance optimization: disk page cache with advanced-cache drop-in, automatic purge, browser cache/gzip rules, HTML and CSS minify, defer and delay JS, image and iframe lazyload, YouTube facade, sitemap and link preload, CDN, database cleanup."
msgstr "Caching e ottimizzazione delle prestazioni: page cache su disco con drop-in advanced-cache, purge automatico, regole browser cache/gzip, minify HTML e CSS, defer e delay JS, lazyload immagini e iframe, facade YouTube, preload da sitemap e dei link, CDN, pulizia database."

#. Author of the plugin
#: speed-kit.php
msgid "Domenico Sacchi"
msgstr "Domenico Sacchi"

#: admin/class-skit-admin.php:85
#: admin/class-skit-admin.php:728
msgid "Purge all cache"
msgstr "Svuota tutta la cache"

#: admin/class-skit-admin.php:96
msgid "Purge this page"
msgstr "Svuota cache di questa pagina"

#: admin/class-skit-admin.php:109
msgid "Start cache preload"
msgstr "Avvia preload cache"

#: admin/class-skit-admin.php:168
msgid "You do not have permission to do this."
msgstr "Permessi insufficienti."

#: admin/class-skit-admin.php:212
#: admin/class-skit-admin.php:730
msgid "Reinstall components"
msgstr "Reinstalla componenti"

#: admin/class-skit-admin.php:216
msgid "WP Rocket is still active. Deactivate it, then activate SpeedKit again (or use \"Reinstall components\" in the settings) to install the drop-in and the rules."
msgstr "WP Rocket è ancora attivo. Disattivalo e poi riattiva SpeedKit (o usa \"Reinstalla componenti\" nelle impostazioni) per installare drop-in e regole."

#: admin/class-skit-admin.php:218
msgid "An advanced-cache.php file from another cache plugin is present. Remove it and use \"Reinstall components\" in the SpeedKit settings."
msgstr "È presente un advanced-cache.php di un altro plugin di cache. Rimuovilo e usa \"Reinstalla componenti\" nelle impostazioni di SpeedKit."

#. translators: %s: comma-separated list of plugin names.
#: admin/class-skit-admin.php:229
#, php-format
msgid "Other cache plugins are active (%s). Two page caches overwrite each other: deactivate one of them."
msgstr "Sono attivi altri plugin di cache (%s). Due page cache insieme si sovrascrivono a vicenda: disattivane una."

#: admin/class-skit-admin.php:239
msgid "The advanced-cache.php drop-in is not active (WP_CACHE missing or file absent): pages are not served from the cache."
msgstr "Il drop-in advanced-cache.php non è attivo (WP_CACHE mancante o file assente): le pagine non vengono servite dalla cache."

#. translators: 1: old drop-in version, 2: plugin version.
#: admin/class-skit-admin.php:250
#, php-format
msgid "advanced-cache.php drop-in updated automatically from version %1$s to %2$s. Reload the page to confirm."
msgstr "Drop-in advanced-cache.php aggiornato automaticamente dalla versione %1$s alla %2$s. Ricarica la pagina per confermare."

#. translators: 1: drop-in version, 2: plugin version.
#: admin/class-skit-admin.php:262
#, php-format
msgid "The advanced-cache.php drop-in (version %1$s) does not match the plugin (version %2$s) and the automatic copy failed: check the permissions of wp-content."
msgstr "Il drop-in advanced-cache.php (versione %1$s) non corrisponde al plugin (versione %2$s) e la copia automatica non è riuscita: controlla i permessi di wp-content."

#: admin/class-skit-admin.php:274
msgid "Cache purged."
msgstr "Cache svuotata."

#: admin/class-skit-admin.php:275
msgid "Preload started: the cache will be rebuilt in the background."
msgstr "Preload avviato: la cache verrà rigenerata in background."

#: admin/class-skit-admin.php:276
msgid "Settings saved. Cache purged and configuration regenerated."
msgstr "Impostazioni salvate. Cache svuotata e configurazione rigenerata."

#: admin/class-skit-admin.php:277
msgid "Components reinstalled (drop-in, WP_CACHE, .htaccess rules, config)."
msgstr "Componenti reinstallati (drop-in, WP_CACHE, regole .htaccess, config)."

#: admin/class-skit-admin.php:278
msgid "Database cleaned."
msgstr "Database ripulito."

#: admin/class-skit-admin.php:283
msgid "revisions"
msgstr "revisioni"

#: admin/class-skit-admin.php:284
msgid "auto-drafts"
msgstr "bozze automatiche"

#: admin/class-skit-admin.php:285
msgid "trashed posts"
msgstr "post nel cestino"

#: admin/class-skit-admin.php:286
msgid "spam/trashed comments"
msgstr "commenti spam/cestino"

#: admin/class-skit-admin.php:287
msgid "expired transients"
msgstr "transient scaduti"

#. translators: %s: comma-separated list such as "revisions: 3, auto-drafts: 0".
#: admin/class-skit-admin.php:295
#, php-format
msgid "Database cleaned: %s."
msgstr "Database ripulito: %s."

#: admin/class-skit-admin.php:300

msgstr "Pulizia database non eseguita: spunta la casella di conferma."

#: admin/class-skit-admin.php:356
msgid "Settings"
msgstr "Impostazioni"

#: admin/class-skit-admin.php:446
msgid "Never (automatic purge only)"
msgstr "Mai (solo purge automatico)"

#: admin/class-skit-admin.php:447
msgid "1 hour"
msgstr "1 ora"

#: admin/class-skit-admin.php:448
msgid "5 hours"
msgstr "5 ore"

#: admin/class-skit-admin.php:449

msgstr "Pulizia database non eseguita: spunta la casella di conferma."

#: admin/class-skit-admin.php:357
msgid "Settings"
msgstr "Impostazioni"

#: admin/class-skit-admin.php:447
msgid "Never (automatic purge only)"
msgstr "Mai (solo purge automatico)"

#: admin/class-skit-admin.php:448
msgid "1 hour"
msgstr "1 ora"

#: admin/class-skit-admin.php:449
msgid "5 hours"
msgstr "5 ore"

#: admin/class-skit-admin.php:450
msgid "10 hours (recommended)"
msgstr "10 ore (consigliato)"

#: admin/class-skit-admin.php:451
msgid "24 hours"
msgstr "24 ore"

#: admin/class-skit-admin.php:452
msgid "7 days"
msgstr "7 giorni"

#. translators: 1: number of cached pages, 2: total size (e.g. "1 MB").
#: admin/class-skit-admin.php:464
#, php-format
msgid "Page cache: %1$s files, %2$s."
msgstr "Cache pagine: %1$s file, %2$s."

#: admin/class-skit-admin.php:469
msgid "Drop-in:"
msgstr "Drop-in:"

#: admin/class-skit-admin.php:469
msgid "active"
msgstr "attivo"

#: admin/class-skit-admin.php:469
msgid "NOT active"
msgstr "NON attivo"

#: admin/class-skit-admin.php:476
#: admin/class-skit-admin.php:479
msgid "Page cache"
msgstr "Cache pagine"

#: admin/class-skit-admin.php:481
msgid "Enable the disk cache for pages"
msgstr "Abilita la cache su disco delle pagine"

#: admin/class-skit-admin.php:485
msgid "Lifespan"
msgstr "Durata di vita"

#: admin/class-skit-admin.php:492
msgid "Older files are deleted by an hourly cron job and rebuilt on the next visit (or by the preload)."
msgstr "I file più vecchi vengono eliminati da un cron orario e rigenerati alla visita successiva (o dal preload)."

#: admin/class-skit-admin.php:496
msgid "Separate mobile cache"
msgstr "Cache mobile separata"

#: admin/class-skit-admin.php:498
msgid "Separate files for mobile devices (only needed with non-responsive themes)"
msgstr "File separati per dispositivi mobili (serve solo con temi non responsive)"

#: admin/class-skit-admin.php:502
msgid "Excluded URIs"
msgstr "URI esclusi"

#: admin/class-skit-admin.php:505
msgid "One regex per line, matched against the URL path."
msgstr "Una regex per riga, confrontata con il percorso dell'URL."

#: admin/class-skit-admin.php:509
msgid "Ignored query parameters"
msgstr "Parametri query ignorati"

#: admin/class-skit-admin.php:511
msgid "Empty = default list (utm_*, fbclid, gclid...)"
msgstr "Vuoto = lista predefinita (utm_*, fbclid, gclid...)"

#: admin/class-skit-admin.php:512
msgid "URLs that only carry these parameters get the cache of the base page. Empty = default list."
msgstr "Gli URL con solo questi parametri ricevono la cache della pagina base. Vuoto = lista predefinita."

#: admin/class-skit-admin.php:516
msgid "Cookies that bypass the cache"
msgstr "Cookie che escludono dalla cache"

#. translators: %s: list of default cookie name prefixes.
#: admin/class-skit-admin.php:523
#, php-format
msgid "One cookie name prefix per line, in addition to the defaults (%s). Visitors carrying one of these cookies neither receive nor generate cached pages."
msgstr "Un prefisso di nome cookie per riga, in aggiunta a quelli predefiniti (%s). Chi ha uno di questi cookie non riceve né genera pagine in cache."

#: admin/class-skit-admin.php:532
msgid "Server rules (.htaccess)"
msgstr "Regole server (.htaccess)"

#: admin/class-skit-admin.php:535
msgid "Direct serving"
msgstr "Serve diretto"

#: admin/class-skit-admin.php:537
msgid "Serve cache files directly from Apache without starting PHP (faster)"
msgstr "Servi i file di cache direttamente da Apache senza avviare PHP (più veloce)"

#: admin/class-skit-admin.php:541
msgid "Browser cache"
msgstr "Browser cache"

#: admin/class-skit-admin.php:543
msgid "Expires/Cache-Control headers for static assets"
msgstr "Intestazioni Expires/Cache-Control per gli asset statici"

#: admin/class-skit-admin.php:547
msgid "Gzip compression"
msgstr "Compressione gzip"

#: admin/class-skit-admin.php:549
msgid "Compress HTML, CSS, JS and fonts with mod_deflate"
msgstr "Comprimi HTML, CSS, JS e font con mod_deflate"

#: admin/class-skit-admin.php:554
msgid "Optimizations"
msgstr "Ottimizzazioni"

#: admin/class-skit-admin.php:557
msgid "Minify HTML"
msgstr "Minify HTML"

#: admin/class-skit-admin.php:558
msgid "Remove whitespace and comments from the cached HTML"
msgstr "Rimuovi spazi e commenti dall'HTML in cache"

#: admin/class-skit-admin.php:561
msgid "Defer JavaScript"
msgstr "Defer JavaScript"

#: admin/class-skit-admin.php:563
msgid "Load external scripts with the <code>defer</code> attribute"
msgstr "Carica gli script esterni con l'attributo <code>defer</code>"

#: admin/class-skit-admin.php:565
msgid "Exclusions: one regex per line, matched against the script URL. jQuery is excluded automatically."
msgstr "Esclusioni: una regex per riga sull'URL dello script. jQuery è escluso automaticamente."

#: admin/class-skit-admin.php:569
msgid "Delay JavaScript"
msgstr "Delay JavaScript"

#: admin/class-skit-admin.php:571
msgid "Delay JavaScript execution until the first interaction (replaces defer)"
msgstr "Rinvia l'esecuzione JS alla prima interazione (sostituisce il defer)"

#: admin/class-skit-admin.php:572
msgid "text found in the script tag to exclude"
msgstr "stringa contenuta nel tag script da escludere"

#: admin/class-skit-admin.php:573
msgid "Very aggressive: test analytics, consent and critical scripts carefully. Exclusions: one string per line."
msgstr "Molto aggressivo: testa bene analytics, consensi e script critici. Esclusioni: una stringa per riga."

#: admin/class-skit-admin.php:577
msgid "Lazyload iframes"
msgstr "Lazyload iframe"

#: admin/class-skit-admin.php:578
msgid "Add <code>loading=\"lazy\"</code> to iframes"
msgstr "Aggiungi <code>loading=\"lazy\"</code> agli iframe"

#: admin/class-skit-admin.php:581
msgid "DNS prefetch"
msgstr "DNS prefetch"

#: admin/class-skit-admin.php:584
msgid "One host per line: a <code>&lt;link rel=\"dns-prefetch\"&gt;</code> is added for each."
msgstr "Un host per riga: per ciascuno viene aggiunto <code>&lt;link rel=\"dns-prefetch\"&gt;</code>."

#: admin/class-skit-admin.php:589
msgid "Media"
msgstr "Media"

#: admin/class-skit-admin.php:592
msgid "Lazyload images"
msgstr "Lazyload immagini"

#: admin/class-skit-admin.php:594
msgid "Add <code>loading=\"lazy\"</code> and <code>decoding=\"async\"</code> to images"
msgstr "Aggiungi <code>loading=\"lazy\"</code> e <code>decoding=\"async\"</code> alle immagini"

#. translators: %s: number input.
#: admin/class-skit-admin.php:600
#, php-format
msgid "Skip the first %s images"
msgstr "Salta le prime %s immagini"

#: admin/class-skit-admin.php:606
msgid "The first images (logo, featured image / LCP) must load right away. Images with <code>fetchpriority=\"high\"</code> are never lazyloaded. Exclude single images with the <code>skip-lazy</code> class."
msgstr "Le prime immagini (logo, immagine in evidenza / LCP) devono caricarsi subito. Le immagini con <code>fetchpriority=\"high\"</code> non vengono mai caricate in lazyload. Escludi singole immagini con la classe <code>skip-lazy</code>."

#: admin/class-skit-admin.php:610
msgid "YouTube facade"
msgstr "Facade YouTube"

#: admin/class-skit-admin.php:612
msgid "Replace YouTube iframes with their thumbnail; the player loads only on click"
msgstr "Sostituisci gli iframe YouTube con la thumbnail; il player si carica solo al click"

#: admin/class-skit-admin.php:613
msgid "The YouTube player and its scripts are not downloaded until the visitor clicks play. The thumbnail is loaded from i.ytimg.com and the player from youtube-nocookie.com."
msgstr "Il player YouTube e i suoi script non vengono scaricati finché il visitatore non preme play. La thumbnail viene caricata da i.ytimg.com e il player da youtube-nocookie.com."

#: admin/class-skit-admin.php:618
msgid "Static assets"
msgstr "Asset statici"

#: admin/class-skit-admin.php:621
msgid "Minify CSS"
msgstr "Minify CSS"

#: admin/class-skit-admin.php:623
msgid "Minify local stylesheets (<code>.min.css</code> files are skipped)"
msgstr "Minifica i fogli di stile locali (i <code>.min.css</code> vengono saltati)"

#: admin/class-skit-admin.php:624
msgid "regex on the URL of the CSS file to exclude"
msgstr "regex sull'URL del CSS da escludere"

#: admin/class-skit-admin.php:628
msgid "Google Fonts"
msgstr "Google Fonts"

#: admin/class-skit-admin.php:629
msgid "Add <code>display=swap</code> and a preconnect to fonts.gstatic.com"
msgstr "Aggiungi <code>display=swap</code> e preconnect a fonts.gstatic.com"

#: admin/class-skit-admin.php:632
msgid "Preload fonts"
msgstr "Preload font"

#: admin/class-skit-admin.php:635
msgid "URLs of critical fonts (one per line): they are preloaded with <code>&lt;link rel=\"preload\"&gt;</code>."
msgstr "URL dei font critici (uno per riga): vengono precaricati con <code>&lt;link rel=\"preload\"&gt;</code>."

#: admin/class-skit-admin.php:639
msgid "Emoji"
msgstr "Emoji"

#: admin/class-skit-admin.php:640
msgid "Remove the WordPress emoji script (browsers render emoji natively)"
msgstr "Rimuovi lo script emoji di WordPress (i browser le rendono nativamente)"

#: admin/class-skit-admin.php:643
msgid "Preload links"
msgstr "Preload link"

#: admin/class-skit-admin.php:645
msgid "Prefetch internal pages when the mouse hovers a link"
msgstr "Prefetch delle pagine interne al passaggio del mouse sui link"

#: admin/class-skit-admin.php:646
msgid "The next navigation starts from the browser cache (instant.page style). Links with a query string, <code>rel=\"nofollow\"</code>, <code>download</code> or <code>data-no-prefetch</code> are skipped."
msgstr "La navigazione successiva parte dalla cache del browser (stile instant.page). I link con query string, <code>rel=\"nofollow\"</code>, <code>download</code> o <code>data-no-prefetch</code> vengono saltati."

#: admin/class-skit-admin.php:651
msgid "CDN"
msgstr "CDN"

#: admin/class-skit-admin.php:654
msgid "URL rewriting"
msgstr "Riscrittura URL"

#: admin/class-skit-admin.php:656
msgid "Serve static assets from a CDN host"
msgstr "Servi gli asset statici da un host CDN"

#: admin/class-skit-admin.php:660
msgid "Only the hostname of the CDN / pull zone. URLs under <code>/wp-content/</code> and <code>/wp-includes/</code> are rewritten."
msgstr "Solo l'hostname del CDN/pull zone. Vengono riscritti gli URL sotto <code>/wp-content/</code> e <code>/wp-includes/</code>."

#: admin/class-skit-admin.php:665
msgid "Reverse proxy (Varnish)"
msgstr "Reverse proxy (Varnish)"

#: admin/class-skit-admin.php:668
msgid "Varnish purge"
msgstr "Purge Varnish"

#: admin/class-skit-admin.php:673
msgid "Cloudways Varnish"
msgstr "Varnish di Cloudways"

#: admin/class-skit-admin.php:674
msgid "Varnish"
msgstr "Varnish"

#: admin/class-skit-admin.php:675
msgid "none"
msgstr "nessuno"

#. translators: %s: reverse proxy detected on the server, e.g. "Cloudways Varnish" or "none".
#: admin/class-skit-admin.php:679
#, php-format
msgid "Automatic (detected: %s)"
msgstr "Automatico (rilevato: %s)"

#: admin/class-skit-admin.php:680
msgid "Cloudways (URLPURGE / PURGE to 127.0.0.1)"
msgstr "Cloudways (URLPURGE / PURGE verso 127.0.0.1)"

#: admin/class-skit-admin.php:681
msgid "Generic Varnish (PURGE with X-Purge-Method)"
msgstr "Varnish generico (PURGE con X-Purge-Method)"

#: admin/class-skit-admin.php:682
msgid "Off"
msgstr "Disattivato"

#: admin/class-skit-admin.php:690
msgid "When content changes SpeedKit also purges the affected URLs from Varnish. Automatic mode detects Varnish from the headers of your admin requests and sends nothing when no Varnish is found. The target IP can be changed with the SKIT_VARNISH_IP constant."
msgstr "Quando i contenuti cambiano SpeedKit svuota gli URL interessati anche da Varnish. La modalità automatica rileva Varnish dalle intestazioni delle tue richieste in admin e non invia nulla se Varnish non viene trovato. L'IP di destinazione si può cambiare con la costante SKIT_VARNISH_IP."

#: admin/class-skit-admin.php:695
msgid "Database"
msgstr "Database"

#: admin/class-skit-admin.php:698
msgid "Automatic cleanup"
msgstr "Pulizia automatica"

#: admin/class-skit-admin.php:700
msgid "Weekly cleanup: revisions, auto-drafts older than 7 days, trash, spam, expired transients"
msgstr "Pulizia settimanale: revisioni, bozze automatiche più vecchie di 7 giorni, cestino, spam, transient scaduti"

#: admin/class-skit-admin.php:701
msgid "Warning: revisions and trashed items are deleted permanently. You can also run it manually from the Tools below."
msgstr "Attenzione: revisioni e cestino vengono eliminati definitivamente. Puoi anche lanciarla manualmente dagli Strumenti qui sotto."

#: admin/class-skit-admin.php:706
msgid "Preload"
msgstr "Preload"

#: admin/class-skit-admin.php:709
msgid "Automatic preload"
msgstr "Preload automatico"

#: admin/class-skit-admin.php:711
msgid "Rebuild the cache from the sitemap after every full purge"
msgstr "Rigenera la cache dalla sitemap dopo ogni svuotamento completo"

#: admin/class-skit-admin.php:715
msgid "Sitemap URL"
msgstr "URL sitemap"

#: admin/class-skit-admin.php:718
msgid "Empty = automatic detection (sitemap_index.xml, sitemap.xml, wp-sitemap.xml)."
msgstr "Vuoto = rilevamento automatico (sitemap_index.xml, sitemap.xml, wp-sitemap.xml)."

#: admin/class-skit-admin.php:723
msgid "Save settings"
msgstr "Salva impostazioni"

#: admin/class-skit-admin.php:726
msgid "Tools"
msgstr "Strumenti"

#: admin/class-skit-admin.php:729
msgid "Start preload"
msgstr "Avvia preload"

#: admin/class-skit-admin.php:732
msgid "\"Reinstall components\" rewrites the advanced-cache.php drop-in, WP_CACHE, the .htaccess rules and the configuration file."
msgstr "\"Reinstalla componenti\" riscrive il drop-in advanced-cache.php, WP_CACHE, le regole .htaccess e il file di configurazione."

#: admin/class-skit-admin.php:733
msgid "Permanently delete revisions, old auto-drafts, trash, spam and expired transients?"
msgstr "Eliminare definitivamente revisioni, bozze automatiche vecchie, cestino, spam e transient scaduti?"

#: admin/class-skit-admin.php:737
msgid "I understand that revisions, auto-drafts older than 7 days, trashed posts, spam/trashed comments and expired transients are deleted permanently."
msgstr "Ho capito che revisioni, bozze automatiche più vecchie di 7 giorni, post nel cestino, commenti spam/cestinati e transient scaduti vengono eliminati definitivamente."

#: admin/class-skit-admin.php:739
msgid "Clean up database now"
msgstr "Pulisci database ora"

#: includes/class-skit-media.php:171
msgid "YouTube video"
msgstr "Video YouTube"

#. translators: %s: video title.
#: includes/class-skit-media.php:188
#, php-format
msgid "Play: %s"
msgstr "Riproduci: %s"

#: includes/class-skit-preload.php:47
msgid "Every minute (SpeedKit preload)"
msgstr "Ogni minuto (preload SpeedKit)"

